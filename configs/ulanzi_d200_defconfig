# Ulanzi D200 (Rockchip RK3308B-S, 4x Cortex-A35)
BR2_aarch64=y
BR2_cortex_a35=y

# Toolchain: prebuilt Bootlin glibc toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y

# Board files
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="release"

# Rockchip blobs (BL31, DDR init TPL) and Rockchip's flash loader, at the rkbin commit we test with
BR2_PACKAGE_D200_RKBIN=y
BR2_PACKAGE_D200_RKBIN_VERSION="3e288fe814e059dd06833495f845cab04ac20a5c"
BR2_PACKAGE_D200_RKBIN_TPL_FILENAME="bin/rk33/rk3308_ddr_589MHz_uart2_m1_v2.11.bin"
BR2_PACKAGE_D200_RKBIN_BL31_FILENAME="bin/rk33/rk3308_bl31_v2.28.elf"

# U-Boot: mainline v2026.10 + board/ulanzi/d200/patches/uboot/2026.10/*.patch
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="ulanzi-d200-rk3308"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/uboot-release.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="BL31=$(BINARIES_DIR)/rkbin-bl31.elf ROCKCHIP_TPL=$(BINARIES_DIR)/rkbin-tpl.bin"
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="idbloader.img u-boot.itb"
# Default env for fw_printenv/fw_setenv (libubootenv)
BR2_TARGET_UBOOT_INITIAL_ENV=y

# Kernel: mainline v7.2.11 + board/ulanzi/d200/patches/linux/7.2.11/*.patch, minimal config
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.11"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/linux.config"
BR2_LINUX_KERNEL_IMAGEGZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3308-ulanzi-d200"

# mkfs.vfat + mcopy for the USB drive image (post-build.sh)
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
# mkimage for the kernel FIT image (post-image.sh)
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y

# System: BusyBox init. This is the release build (no shell on the UART, no SSH);
# board/ulanzi/d200/debug.fragment adds both for the debug build.
BR2_TARGET_GENERIC_HOSTNAME="d200"
BR2_TARGET_GENERIC_ISSUE="Ulanzi D200"
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# Read-only root (A/B slots); settings and the incoming update live on /data
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# fw_printenv/fw_setenv: the updater switches slots through the U-Boot env
BR2_PACKAGE_LIBUBOOTENV=y
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
# USB Ethernet: d200-<serial>.local, and IPv6 addresses for the PC (radvd is
# started by S30usb-gadget)
BR2_PACKAGE_MDNSD=y
BR2_PACKAGE_MDNSD_HTTP_SERVICE=y
BR2_PACKAGE_RADVD=y
# D200 tools (reboot-to) and the key app and update page (deckd)
BR2_PACKAGE_D200_UTILS=y
BR2_PACKAGE_HOST_GO=y
BR2_PACKAGE_D200_DECK=y
# BusyBox additions (udhcpd for the USB Ethernet gadget)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/busybox.fragment"

# Rootfs: UBIFS for the "rootfs_a"/"rootfs_b" UBI volumes (2 KiB pages, 128 KiB blocks -> 124 KiB LEBs)
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000
BR2_TARGET_ROOTFS_UBIFS_MINIOSIZE=0x800
BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=2048
# Free space fixup on the first read-write mount: raw flashers (rkdeveloptool)
# write the image's empty 0xff pages, and NAND pages can't be programmed twice.
# The root is mounted read-only, so this only matters for a manual remount.
BR2_TARGET_ROOTFS_UBIFS_OPTS="-F"

# Debug build, merged on top of ulanzi_d200_defconfig:
# root shell on the UART (no login), SSH + SFTP over USB Ethernet (root, no
# password), modetest, and the stock U-Boot console.
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /bin/sh"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_GESFTPSERVER=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES=""
BR2_ROOTFS_POST_SCRIPT_ARGS="debug"

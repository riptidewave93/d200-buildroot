From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sun, 18 Oct 2026 10:09:12 -0500
Subject: [PATCH] arm64: dts: rockchip: add Ulanzi D200

The Ulanzi D200 is a stream controller based on the RK3308B-S with
128 MiB DDR3, a GigaDevice GD5F2GM7 SPI NAND on the SFC and a 720x1280
RGB LCD. The debug console is UART2 on the m1 pins (GPIO4_D2/D3).

Describe the console, the SPI NAND with its partition layout, the
display (VOP -> NV3052C based panel described with the
rockchip,cmd-panel properties, mounted rotated by 90 degrees, PWM
backlight at full brightness), the keys (a 3x5 GPIO matrix, one key code
per key), the watchdog (which can already be running at handoff, so it
must be serviced) and USB OTG in peripheral mode.

The OTG FIFO split follows the vendor firmware: a larger RX FIFO than the
rk3308.dtsi default, without which OUT transfers stall in device mode.
A "maskrom" reboot mode makes the BootROM enter USB download mode.

SPI NAND layout:
  0x000000  idbloader      (BootROM reads up to 4 IDB copies at
                            0, 0x40000, 0x80000, 0xc0000)
  0x100000  u-boot         (FIT, loaded by SPL)
  0x500000  u-boot-backup  (redundant FIT)
  0x900000  ubi            (everything else)

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 .../src/arm64/rockchip/rk3308-ulanzi-d200.dts | 374 ++++++++++++++++++
 1 file changed, 374 insertions(+)
 create mode 100644 dts/upstream/src/arm64/rockchip/rk3308-ulanzi-d200.dts

diff --git a/dts/upstream/src/arm64/rockchip/rk3308-ulanzi-d200.dts b/dts/upstream/src/arm64/rockchip/rk3308-ulanzi-d200.dts
new file mode 100644
index 00000000..fca2a0d3
--- /dev/null
+++ b/dts/upstream/src/arm64/rockchip/rk3308-ulanzi-d200.dts
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Ulanzi D200 stream controller (RK3308B-S, 128 MiB DDR3, GD5F2GM7 SPI NAND,
+ * 720x1280 RGB LCD behind the keys)
+ */
+
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "rk3308bs.dtsi"
+
+/ {
+	model = "Ulanzi D200";
+	compatible = "ulanzi,d200", "rockchip,rk3308";
+
+	aliases {
+		serial2 = &uart2;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm1 0 25000 0>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <255>;	/* 100% during boot */
+	};
+
+	/*
+	 * The keys as seen from the front: 3 rows, 5 columns. The wide key at
+	 * the bottom right sits on column 5, column 4 of the bottom row has no
+	 * key. Each key gets its own code, in reading order.
+	 */
+	keypad {
+		compatible = "gpio-matrix-keypad";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_rows &key_cols>;
+		row-gpios = <&gpio4 RK_PD1 GPIO_ACTIVE_LOW>,
+			    <&gpio4 RK_PD0 GPIO_ACTIVE_LOW>,
+			    <&gpio4 RK_PD4 GPIO_ACTIVE_LOW>;
+		col-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_LOW>,
+			    <&gpio4 RK_PB7 GPIO_ACTIVE_LOW>,
+			    <&gpio4 RK_PC0 GPIO_ACTIVE_LOW>,
+			    <&gpio4 RK_PD6 GPIO_ACTIVE_LOW>,
+			    <&gpio4 RK_PD5 GPIO_ACTIVE_LOW>;
+		gpio-activelow;
+		/* some columns are slow to settle */
+		col-scan-delay-us = <60>;
+		debounce-delay-ms = <20>;
+		linux,no-autorepeat;
+		linux,keymap = <
+			MATRIX_KEY(0, 0, KEY_F13)
+			MATRIX_KEY(0, 1, KEY_F14)
+			MATRIX_KEY(0, 2, KEY_F15)
+			MATRIX_KEY(0, 3, KEY_F16)
+			MATRIX_KEY(0, 4, KEY_F17)
+			MATRIX_KEY(1, 0, KEY_F18)
+			MATRIX_KEY(1, 1, KEY_F19)
+			MATRIX_KEY(1, 2, KEY_F20)
+			MATRIX_KEY(1, 3, KEY_F21)
+			MATRIX_KEY(1, 4, KEY_F22)
+			MATRIX_KEY(2, 0, KEY_F23)
+			MATRIX_KEY(2, 1, KEY_F24)
+			MATRIX_KEY(2, 2, KEY_PROG1)
+			MATRIX_KEY(2, 4, KEY_PROG2)
+		>;
+	};
+
+	/*
+	 * NV3052C based 720x1280 RGB panel, initialised over a 3-wire SPI link
+	 * bit-banged on GPIO2.
+	 */
+	panel: panel {
+		compatible = "rockchip,cmd-panel";
+		rockchip,cmd-type = "spi";
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_enable_pin &lcd_reset_pin &lcd_spi_pins>;
+		spi-scl-gpios = <&gpio2 RK_PA2 GPIO_ACTIVE_HIGH>;
+		spi-sdi-gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_HIGH>;
+		spi-cs-gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_LOW>;
+		reset-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_LOW>;
+		prepare-delay-ms = <20>;
+		reset-delay-ms = <200>;
+		init-delay-ms = <210>;
+		enable-delay-ms = <200>;
+		backlight = <&backlight>;
+		/* portrait panel mounted in a landscape device */
+		rotation = <90>;
+		panel-init-sequence = [
+			00 00 01 ff 01 00 01 30 00 00 01 ff 01 00 01 52
+			00 00 01 ff 01 00 01 01 00 00 01 e3 01 00 01 00
+			00 00 01 0a 01 00 01 00 00 00 01 23 01 00 01 a2
+			00 00 01 24 01 00 01 3c 00 00 01 25 01 00 01 0f
+			00 00 01 26 01 00 01 3c 00 00 01 27 01 00 01 46
+			00 00 01 29 01 00 01 04 00 00 01 2a 01 00 01 ff
+			00 00 01 38 01 00 01 9c 00 00 01 39 01 00 01 a7
+			00 00 01 3a 01 00 01 3f 00 00 01 91 01 00 01 67
+			00 00 01 92 01 00 01 67 00 00 01 99 01 00 01 56
+			00 00 01 9b 01 00 01 59 00 00 01 a0 01 00 01 55
+			00 00 01 a1 01 00 01 50 00 00 01 a4 01 00 01 9c
+			00 00 01 a7 01 00 01 02 00 00 01 a8 01 00 01 01
+			00 00 01 a9 01 00 01 01 00 00 01 aa 01 00 01 fc
+			00 00 01 ab 01 00 01 28 00 00 01 ac 01 00 01 06
+			00 00 01 ad 01 00 01 06 00 00 01 ae 01 00 01 06
+			00 00 01 af 01 00 01 03 00 00 01 b0 01 00 01 08
+			00 00 01 b1 01 00 01 26 00 00 01 b2 01 00 01 28
+			00 00 01 b3 01 00 01 28 00 00 01 b4 01 00 01 03
+			00 00 01 b5 01 00 01 08 00 00 01 b6 01 00 01 26
+			00 00 01 b7 01 00 01 08 00 00 01 b8 01 00 01 26
+			00 00 01 ff 01 00 01 30 00 00 01 ff 01 00 01 52
+			00 00 01 ff 01 00 01 02 00 00 01 b0 01 00 01 02
+			00 00 01 b1 01 00 01 10 00 00 01 b2 01 00 01 10
+			00 00 01 b3 01 00 01 35 00 00 01 b4 01 00 01 39
+			00 00 01 b5 01 00 01 3e 00 00 01 b6 01 00 01 1d
+			00 00 01 b7 01 00 01 3a 00 00 01 b8 01 00 01 0d
+			00 00 01 b9 01 00 01 04 00 00 01 ba 01 00 01 10
+			00 00 01 bb 01 00 01 11 00 00 01 bc 01 00 01 11
+			00 00 01 bd 01 00 01 13 00 00 01 be 01 00 01 17
+			00 00 01 bf 01 00 01 0d 00 00 01 c0 01 00 01 15
+			00 00 01 c1 01 00 01 08 00 00 01 d0 01 00 01 03
+			00 00 01 d1 01 00 01 0e 00 00 01 d2 01 00 01 0c
+			00 00 01 d3 01 00 01 33 00 00 01 d4 01 00 01 35
+			00 00 01 d5 01 00 01 3d 00 00 01 d6 01 00 01 15
+			00 00 01 d7 01 00 01 34 00 00 01 d8 01 00 01 0d
+			00 00 01 d9 01 00 01 04 00 00 01 da 01 00 01 10
+			00 00 01 db 01 00 01 0f 00 00 01 dc 01 00 01 11
+			00 00 01 dd 01 00 01 13 00 00 01 de 01 00 01 15
+			00 00 01 df 01 00 01 0d 00 00 01 e0 01 00 01 15
+			00 00 01 e1 01 00 01 08 00 00 01 ff 01 00 01 30
+			00 00 01 ff 01 00 01 52 00 00 01 ff 01 00 01 03
+			00 00 01 04 01 00 01 a1 00 00 01 05 01 00 01 07
+			00 00 01 06 01 00 01 07 00 00 01 08 01 00 01 09
+			00 00 01 09 01 00 01 0a 00 00 01 24 01 00 01 a1
+			00 00 01 25 01 00 01 07 00 00 01 26 01 00 01 07
+			00 00 01 2a 01 00 01 0b 00 00 01 2b 01 00 01 0c
+			00 00 01 2c 01 00 01 0d 00 00 01 2d 01 00 01 0e
+			00 00 01 70 01 00 01 0f 00 00 01 71 01 00 01 c0
+			00 00 01 34 01 00 01 a1 00 00 01 35 01 00 01 07
+			00 00 01 36 01 00 01 07 00 00 01 37 01 00 01 25
+			00 00 01 40 01 00 01 0a 00 00 01 41 01 00 01 0b
+			00 00 01 42 01 00 01 0c 00 00 01 43 01 00 01 0d
+			00 00 01 45 01 00 01 0b 00 00 01 46 01 00 01 0c
+			00 00 01 48 01 00 01 0d 00 00 01 49 01 00 01 0e
+			00 00 01 50 01 00 01 0e 00 00 01 51 01 00 01 0f
+			00 00 01 52 01 00 01 10 00 00 01 53 01 00 01 11
+			00 00 01 55 01 00 01 0f 00 00 01 56 01 00 01 10
+			00 00 01 58 01 00 01 11 00 00 01 59 01 00 01 12
+			00 00 01 60 01 00 01 12 00 00 01 61 01 00 01 13
+			00 00 01 62 01 00 01 14 00 00 01 63 01 00 01 15
+			00 00 01 64 01 00 01 55 00 00 01 65 01 00 01 13
+			00 00 01 66 01 00 01 14 00 00 01 67 01 00 01 55
+			00 00 01 68 01 00 01 15 00 00 01 69 01 00 01 16
+			00 00 01 80 01 00 01 18 00 00 01 81 01 00 01 17
+			00 00 01 82 01 00 01 0a 00 00 01 83 01 00 01 0c
+			00 00 01 84 01 00 01 0e 00 00 01 85 01 00 01 10
+			00 00 01 86 01 00 01 12 00 00 01 87 01 00 01 14
+			00 00 01 88 01 00 01 06 00 00 01 8a 01 00 01 08
+			00 00 01 93 01 00 01 02 00 00 01 96 01 00 01 16
+			00 00 01 97 01 00 01 15 00 00 01 98 01 00 01 09
+			00 00 01 99 01 00 01 0b 00 00 01 9a 01 00 01 0d
+			00 00 01 9b 01 00 01 0f 00 00 01 9c 01 00 01 11
+			00 00 01 9d 01 00 01 13 00 00 01 9e 01 00 01 05
+			00 00 01 a0 01 00 01 07 00 00 01 a9 01 00 01 01
+			00 00 01 ff 01 00 01 30 00 00 01 ff 01 00 01 52
+			00 00 01 ff 01 00 01 00 00 00 01 36 01 00 01 0a
+			00 00 01 11 01 c8 01 00 00 00 01 29 01 64 01 00
+		];
+		panel-exit-sequence = [
+			00 0a 01 28 00 78 01 10
+		];
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <42000000>;
+				hactive = <720>;
+				vactive = <1280>;
+				hfront-porch = <60>;
+				hback-porch = <60>;
+				hsync-len = <10>;
+				vfront-porch = <60>;
+				vback-porch = <10>;
+				vsync-len = <5>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <1>;
+				pixelclk-active = <1>;
+			};
+		};
+
+		port {
+			panel_in_vop: endpoint {
+				remote-endpoint = <&vop_out_panel>;
+			};
+		};
+	};
+
+	vdd_core: regulator-vdd-core {
+		compatible = "pwm-regulator";
+		pwms = <&pwm0 0 5000 PWM_POLARITY_INVERTED>;
+		regulator-name = "vdd_core";
+		regulator-min-microvolt = <827000>;
+		regulator-max-microvolt = <1340000>;
+		regulator-settling-time-up-us = <250>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x8000000>;
+	};
+
+};
+
+&cpu0 {
+	cpu-supply = <&vdd_core>;
+};
+
+&sfc {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <1>;
+
+		/*
+		 * Raw layout: the BootROM reads the IDB (TPL+SPL) from up to
+		 * four copies at 0, 0x40000, 0x80000 and 0xc0000. SPL loads
+		 * U-Boot from "u-boot", falling back to "u-boot-backup".
+		 * Everything else lives in UBI, except the last 1 MiB, which
+		 * the Rockchip loader keeps for itself. The boot partitions are
+		 * written by fastboot and by the system updater.
+		 */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "idbloader";
+				reg = <0x0 0x100000>;
+			};
+
+			partition@100000 {
+				label = "u-boot";
+				reg = <0x100000 0x400000>;
+			};
+
+			partition@500000 {
+				label = "u-boot-backup";
+				reg = <0x500000 0x400000>;
+			};
+
+			partition@900000 {
+				label = "ubi";
+				reg = <0x900000 0xf600000>;
+			};
+		};
+	};
+};
+
+/* Debug console: UART2 m1 (GPIO4_D2/D3) */
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2m1_xfer>;
+	status = "okay";
+};
+
+/*
+ * U-Boot starts the watchdog, so it is already running at handoff and
+ * must be serviced.
+ */
+&wdt {
+	status = "okay";
+};
+
+&grf {
+	reboot-mode {
+		/* "reboot maskrom": the BootROM enters USB download (maskrom) mode */
+		mode-maskrom = <0xef08a53c>;
+	};
+};
+
+&pinctrl {
+	keys {
+		key_cols: key-cols {
+			rockchip,pins =
+				<4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>,
+				<4 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>,
+				<4 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>,
+				<4 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>,
+				<4 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		key_rows: key-rows {
+			rockchip,pins =
+				<4 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	lcd {
+		lcd_enable_pin: lcd-enable-pin {
+			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		lcd_reset_pin: lcd-reset-pin {
+			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		lcd_spi_pins: lcd-spi-pins {
+			rockchip,pins =
+				<2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
+				<2 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>,
+				<2 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+&display_subsystem {
+	status = "okay";
+};
+
+&pwm0 {
+	pinctrl-0 = <&pwm0_pin_pull_down>;
+	status = "okay";
+};
+
+&pwm1 {
+	status = "okay";
+};
+
+&vop {
+	pinctrl-names = "default";
+	pinctrl-0 = <&lcdc_ctl &lcdc_rgb888_m0>;
+	status = "okay";
+};
+
+&vop_out {
+	vop_out_panel: endpoint@0 {
+		reg = <0>;
+		remote-endpoint = <&panel_in_vop>;
+	};
+};
+
+&tsadc {
+	status = "okay";
+};
+
+&u2phy {
+	status = "okay";
+};
+
+&u2phy_otg {
+	status = "okay";
+};
+
+&usb20_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sun, 18 Oct 2026 10:47:37 -0500
Subject: [PATCH] video: rockchip: add RK3308 VOP driver

The RK3308 has a "VOP lite" (RK3366-lite / PX30-lite register layout)
with a single parallel RGB output, which the existing rk_vop core does
not cover.

Add a small driver that drives one full screen XRGB8888 window, takes
the timing from the panel connected to the VOP output port, sets the
pixel clock and enables the panel/backlight.

The panel's standard "rotation" property is honoured in software:
for 90/270 degrees U-Boot draws into a framebuffer in the rotated
orientation and video_sync() copies the damaged area, rotated, into
a second buffer that the VOP scans out.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 drivers/video/rockchip/Makefile     |   1 +
 drivers/video/rockchip/rk3308_vop.c | 374 ++++++++++++++++++++++++++++
 2 files changed, 375 insertions(+)
 create mode 100644 drivers/video/rockchip/rk3308_vop.c

diff --git a/drivers/video/rockchip/Makefile b/drivers/video/rockchip/Makefile
index f55becee..b7d1934b 100644
--- a/drivers/video/rockchip/Makefile
+++ b/drivers/video/rockchip/Makefile
@@ -6,6 +6,7 @@
 ifdef CONFIG_VIDEO_ROCKCHIP
 obj-y += rk_vop.o
 obj-$(CONFIG_ROCKCHIP_RK3288) += rk3288_vop.o
+obj-$(CONFIG_ROCKCHIP_RK3308) += rk3308_vop.o
 obj-$(CONFIG_ROCKCHIP_RK3328) += rk3328_vop.o
 obj-$(CONFIG_ROCKCHIP_RK3399) += rk3399_vop.o
 obj-$(CONFIG_DISPLAY_ROCKCHIP_EDP) += rk_edp.o
diff --git a/drivers/video/rockchip/rk3308_vop.c b/drivers/video/rockchip/rk3308_vop.c
new file mode 100644
index 00000000..365d84b4
--- /dev/null
+++ b/drivers/video/rockchip/rk3308_vop.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Rockchip RK3308 VOP driver
+ *
+ * The RK3308 has a "VOP lite" (RK3366-lite / PX30-lite register layout)
+ * with a single parallel RGB output. This driver drives one full screen
+ * XRGB8888 window and gets the timing from a panel connected to the VOP
+ * output port.
+ *
+ * The panel's standard "rotation" property (0/90/180/270, counter clockwise)
+ * is honoured in software: U-Boot draws into a framebuffer in the rotated
+ * (logical) orientation and video_sync() copies the damaged area, rotated,
+ * into the buffer the VOP scans out.
+ */
+
+#include <clk.h>
+#include <dm.h>
+#include <log.h>
+#include <panel.h>
+#include <reset.h>
+#include <video.h>
+#include <cpu_func.h>
+#include <asm/cache.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <dm/device_compat.h>
+#include <dm/ofnode.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define VOP_REG_CFG_DONE		0x000
+#define VOP_SYS_CTRL2			0x018
+#define  SYS_CTRL2_STANDBY		BIT(1)
+#define VOP_DSP_CTRL0			0x020
+#define  DSP_CTRL0_RGB_EN		BIT(0)
+#define  DSP_CTRL0_DCLK_POL		BIT(1)
+#define  DSP_CTRL0_HSYNC_POS		BIT(2)
+#define  DSP_CTRL0_VSYNC_POS		BIT(3)
+#define  DSP_CTRL0_DEN_NEG		BIT(4)
+#define VOP_DSP_CTRL2			0x028
+#define  DSP_CTRL2_OUT_MODE_MASK	GENMASK(19, 16)	/* 0: parallel RGB888 */
+#define  DSP_CTRL2_BLACK		BIT(15)
+#define  DSP_CTRL2_BLANK		BIT(14)
+#define VOP_WIN0_CTRL0			0x050
+#define  WIN0_EN			BIT(0)
+#define  WIN0_FMT_MASK			GENMASK(3, 1)	/* 0: ARGB8888 */
+#define VOP_WIN0_VIR			0x05c
+#define VOP_WIN0_YRGB_MST		0x060
+#define VOP_WIN0_ACT_INFO		0x068
+#define VOP_WIN0_DSP_INFO		0x06c
+#define VOP_WIN0_DSP_ST			0x070
+#define VOP_DSP_HTOTAL_HS_END		0x100
+#define VOP_DSP_HACT_ST_END		0x104
+#define VOP_DSP_VTOTAL_VS_END		0x108
+#define VOP_DSP_VACT_ST_END		0x10c
+
+struct rk3308_vop_priv {
+	void __iomem *regs;
+	struct udevice *panel;
+	u32 rot;		/* panel rotation in degrees (0/90/180/270) */
+	u32 *scan;		/* scanout buffer when rotating */
+	u32 pw, ph;		/* panel (scanout) size in pixels */
+};
+
+#define RK3308_VOP_FB_SIZE	(CONFIG_VIDEO_ROCKCHIP_MAX_XRES * \
+				 CONFIG_VIDEO_ROCKCHIP_MAX_YRES * 4)
+
+/* Panel node behind the VOP output port, without probing anything */
+static ofnode rk3308_vop_panel_node(struct udevice *dev)
+{
+	ofnode port, ep, node;
+	u32 phandle;
+
+	port = dev_read_subnode(dev, "port");
+	ofnode_for_each_subnode(ep, port) {
+		if (ofnode_read_u32(ep, "remote-endpoint", &phandle))
+			continue;
+		for (node = ofnode_get_by_phandle(phandle); ofnode_valid(node);
+		     node = ofnode_get_parent(node))
+			if (ofnode_has_property(node, "compatible"))
+				return node;
+	}
+
+	return ofnode_null();
+}
+
+static u32 rk3308_vop_rotation(struct udevice *dev)
+{
+	u32 rot = ofnode_read_u32_default(rk3308_vop_panel_node(dev),
+					  "rotation", 0);
+
+	return (rot % 90 || rot > 270) ? 0 : rot;
+}
+
+/* Follow the VOP output port to the panel: endpoint -> port -> panel */
+static int rk3308_vop_get_panel(struct udevice *dev, struct udevice **panel)
+{
+	ofnode port, ep, remote;
+	u32 phandle;
+
+	port = dev_read_subnode(dev, "port");
+	ofnode_for_each_subnode(ep, port) {
+		if (ofnode_read_u32(ep, "remote-endpoint", &phandle))
+			continue;
+
+		for (remote = ofnode_get_by_phandle(phandle);
+		     ofnode_valid(remote);
+		     remote = ofnode_get_parent(remote)) {
+			if (!uclass_get_device_by_ofnode(UCLASS_PANEL, remote,
+							 panel))
+				return 0;
+		}
+	}
+
+	return -ENODEV;
+}
+
+static void rk3308_vop_enable_clocks(struct udevice *dev,
+				     const struct display_timing *t)
+{
+	struct reset_ctl_bulk resets;
+	struct clk clk;
+	ulong rate;
+
+	if (!clk_get_by_name(dev, "aclk_vop", &clk))
+		clk_enable(&clk);
+	if (!clk_get_by_name(dev, "hclk_vop", &clk))
+		clk_enable(&clk);
+	if (!clk_get_by_name(dev, "dclk_vop", &clk)) {
+		clk_enable(&clk);
+		rate = clk_set_rate(&clk, t->pixelclock.typ);
+		if (IS_ERR_VALUE(rate))
+			dev_warn(dev, "failed to set dclk to %u Hz\n",
+				 t->pixelclock.typ);
+		else
+			dev_dbg(dev, "dclk %lu Hz (wanted %u)\n", rate,
+				t->pixelclock.typ);
+	}
+
+	if (!reset_get_bulk(dev, &resets)) {
+		reset_assert_bulk(&resets);
+		udelay(10);
+		reset_deassert_bulk(&resets);
+	}
+}
+
+static int rk3308_vop_probe(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct rk3308_vop_priv *priv = dev_get_priv(dev);
+	u32 hsync, hbp, hact, htotal, vsync, vbp, vact, vtotal, ctrl0;
+	struct display_timing t;
+	void __iomem *regs;
+	int ret;
+
+	/* Nothing to do before relocation */
+	if (!(gd->flags & GD_FLG_RELOC))
+		return 0;
+
+	priv->regs = dev_read_addr_ptr(dev);
+	if (!priv->regs)
+		return -EINVAL;
+	regs = priv->regs;
+
+	ret = rk3308_vop_get_panel(dev, &priv->panel);
+	if (ret) {
+		dev_err(dev, "no panel found: %d\n", ret);
+		return ret;
+	}
+
+	ret = panel_get_display_timing(priv->panel, &t);
+	if (ret) {
+		dev_err(dev, "failed to get panel timing: %d\n", ret);
+		return ret;
+	}
+
+	rk3308_vop_enable_clocks(dev, &t);
+
+	hsync = t.hsync_len.typ;
+	hbp = t.hback_porch.typ;
+	hact = t.hactive.typ;
+	htotal = hsync + hbp + hact + t.hfront_porch.typ;
+	vsync = t.vsync_len.typ;
+	vbp = t.vback_porch.typ;
+	vact = t.vactive.typ;
+	vtotal = vsync + vbp + vact + t.vfront_porch.typ;
+
+	writel(htotal << 16 | hsync, regs + VOP_DSP_HTOTAL_HS_END);
+	writel((hsync + hbp) << 16 | (hsync + hbp + hact),
+	       regs + VOP_DSP_HACT_ST_END);
+	writel(vtotal << 16 | vsync, regs + VOP_DSP_VTOTAL_VS_END);
+	writel((vsync + vbp) << 16 | (vsync + vbp + vact),
+	       regs + VOP_DSP_VACT_ST_END);
+
+	ctrl0 = DSP_CTRL0_RGB_EN;
+	if (t.flags & DISPLAY_FLAGS_HSYNC_HIGH)
+		ctrl0 |= DSP_CTRL0_HSYNC_POS;
+	if (t.flags & DISPLAY_FLAGS_VSYNC_HIGH)
+		ctrl0 |= DSP_CTRL0_VSYNC_POS;
+	if (t.flags & DISPLAY_FLAGS_DE_LOW)
+		ctrl0 |= DSP_CTRL0_DEN_NEG;
+	if (t.flags & DISPLAY_FLAGS_PIXDATA_NEGEDGE)
+		ctrl0 |= DSP_CTRL0_DCLK_POL;
+	writel(ctrl0, regs + VOP_DSP_CTRL0);
+	clrbits_le32(regs + VOP_DSP_CTRL2, DSP_CTRL2_OUT_MODE_MASK |
+		     DSP_CTRL2_BLACK | DSP_CTRL2_BLANK);
+
+	/* Window 0: full screen, XRGB8888, stride in 32-bit words */
+	writel(hact, regs + VOP_WIN0_VIR);
+	writel((vact - 1) << 16 | (hact - 1), regs + VOP_WIN0_ACT_INFO);
+	writel((vact - 1) << 16 | (hact - 1), regs + VOP_WIN0_DSP_INFO);
+	writel((vsync + vbp) << 16 | (hsync + hbp), regs + VOP_WIN0_DSP_ST);
+	priv->rot = rk3308_vop_rotation(dev);
+	priv->pw = hact;
+	priv->ph = vact;
+	if (priv->rot) {
+		/* scan out of a second buffer, filled rotated by video_sync() */
+		priv->scan = (u32 *)(plat->base + RK3308_VOP_FB_SIZE);
+		memset(priv->scan, 0, hact * vact * 4);
+		flush_dcache_range((ulong)priv->scan,
+				   (ulong)priv->scan + hact * vact * 4);
+		writel((u32)(ulong)priv->scan, regs + VOP_WIN0_YRGB_MST);
+	} else {
+		writel((u32)plat->base, regs + VOP_WIN0_YRGB_MST);
+	}
+	clrsetbits_le32(regs + VOP_WIN0_CTRL0, WIN0_FMT_MASK, WIN0_EN);
+
+	clrbits_le32(regs + VOP_SYS_CTRL2, SYS_CTRL2_STANDBY);
+	writel(1, regs + VOP_REG_CFG_DONE);
+
+	uc_priv->xsize = (priv->rot % 180) ? vact : hact;
+	uc_priv->ysize = (priv->rot % 180) ? hact : vact;
+	uc_priv->bpix = VIDEO_BPP32;
+	/* when rotating, video_sync() flushes the scanout rows it writes */
+	video_set_flush_dcache(dev, !priv->rot);
+
+	ret = panel_enable_backlight(priv->panel);
+	if (ret)
+		dev_warn(dev, "panel enable failed: %d\n", ret);
+
+	return 0;
+}
+
+/* Copy the damaged part of the logical framebuffer, rotated, to scanout */
+static int rk3308_vop_sync(struct udevice *dev)
+{
+	struct rk3308_vop_priv *priv = dev_get_priv(dev);
+	struct video_priv *vid = dev_get_uclass_priv(dev);
+	const u32 pw = priv->pw, ph = priv->ph;
+	int x0 = 0, y0 = 0, x1 = vid->xsize, y1 = vid->ysize;
+	u32 *src = vid->fb, *dst = priv->scan;
+	int x, y, rmin, rmax;
+	ulong start, end;
+
+	if (!priv->rot || !dst)
+		return 0;
+
+	if (IS_ENABLED(CONFIG_VIDEO_DAMAGE)) {
+		x0 = max(vid->damage.xstart, 0);
+		y0 = max(vid->damage.ystart, 0);
+		x1 = min(vid->damage.xend, (int)vid->xsize);
+		y1 = min(vid->damage.yend, (int)vid->ysize);
+		if (x1 <= x0 || y1 <= y0)
+			return 0;
+	}
+
+	if (priv->rot == 180) {
+		/* rows map to rows: already sequential */
+		for (y = y0; y < y1; y++) {
+			const u32 *line = src + y * vid->xsize;
+			u32 *d = dst + (ph - 1 - y) * pw + (pw - 1);
+
+			for (x = x0; x < x1; x++)
+				d[-x] = line[x];
+		}
+	} else {
+		/*
+		 * 90/270: a logical row becomes a scanout column. Copy row by row
+		 * so the reads stay sequential; the copy is memory bandwidth
+		 * bound.
+		 */
+		for (y = y0; y < y1; y++) {
+			const u32 *line = src + y * vid->xsize;
+
+			if (priv->rot == 90)
+				for (x = x0; x < x1; x++)
+					dst[(ph - 1 - x) * pw + y] = line[x];
+			else
+				for (x = x0; x < x1; x++)
+					dst[x * pw + (pw - 1 - y)] = line[x];
+		}
+	}
+
+	/* scanout rows touched by the copy */
+	switch (priv->rot) {
+	case 90:
+		rmin = ph - x1;
+		rmax = ph - 1 - x0;
+		break;
+	case 180:
+		rmin = ph - y1;
+		rmax = ph - 1 - y0;
+		break;
+	default: /* 270 */
+		rmin = x0;
+		rmax = x1 - 1;
+		break;
+	}
+	start = rounddown((ulong)(dst + rmin * pw), ARCH_DMA_MINALIGN);
+	end = roundup((ulong)(dst + (rmax + 1) * pw), ARCH_DMA_MINALIGN);
+	flush_dcache_range(start, end);
+
+	/*
+	 * The uclass calls us on every sync but only clears the damage when
+	 * its own throttle expires; clear it here so nothing is copied twice.
+	 * (The draw buffer itself is not flushed when rotating.)
+	 */
+	if (IS_ENABLED(CONFIG_VIDEO_DAMAGE)) {
+		vid->damage.xstart = vid->xsize;
+		vid->damage.ystart = vid->ysize;
+		vid->damage.xend = 0;
+		vid->damage.yend = 0;
+	}
+
+	return 0;
+}
+
+static const struct video_ops rk3308_vop_ops = {
+	.video_sync = rk3308_vop_sync,
+};
+
+static int rk3308_vop_remove(struct udevice *dev)
+{
+	struct rk3308_vop_priv *priv = dev_get_priv(dev);
+
+	if (!priv->regs)
+		return 0;
+
+	/* Stop scanning out of U-Boot's framebuffer before handing over */
+	clrbits_le32(priv->regs + VOP_WIN0_CTRL0, WIN0_EN);
+	writel(1, priv->regs + VOP_REG_CFG_DONE);
+
+	return 0;
+}
+
+static int rk3308_vop_bind(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+
+	/* a second buffer is needed to scan out a rotated image */
+	plat->size = RK3308_VOP_FB_SIZE * (rk3308_vop_rotation(dev) ? 2 : 1);
+
+	return 0;
+}
+
+static const struct udevice_id rk3308_vop_ids[] = {
+	{ .compatible = "rockchip,rk3308-vop" },
+	{ }
+};
+
+U_BOOT_DRIVER(rk3308_vop) = {
+	.name		= "rk3308_vop",
+	.id		= UCLASS_VIDEO,
+	.of_match	= rk3308_vop_ids,
+	.ops		= &rk3308_vop_ops,
+	.bind		= rk3308_vop_bind,
+	.probe		= rk3308_vop_probe,
+	.remove		= rk3308_vop_remove,
+	.priv_auto	= sizeof(struct rk3308_vop_priv),
+	.flags		= DM_FLAG_OS_PREPARE,
+};

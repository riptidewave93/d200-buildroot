From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sun, 18 Oct 2026 10:47:37 -0500
Subject: [PATCH] video: add a command-sequence panel driver (Rockchip vendor
 DT format)

Many Rockchip based devices use RGB panels that need an init sequence
sent over a 3-wire (9-bit) SPI link before they show anything. The
vendor U-Boot and kernel describe these panels entirely in the device
tree (rockchip,cmd-type, spi-*-gpios, panel-init-sequence, delays and
display-timings).

Add a generic panel driver that understands those properties, so such
a panel node can be reused almost verbatim. The 3-wire link is
bit-banged on GPIOs, the power-up sequence uses the delays from the
device tree, and the timing comes from display-timings (native-mode) or
panel-timing. Only rockchip,cmd-type = "spi" is supported.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 drivers/video/Kconfig              |  10 +
 drivers/video/Makefile             |   1 +
 drivers/video/rockchip-cmd-panel.c | 311 +++++++++++++++++++++++++++++
 3 files changed, 322 insertions(+)
 create mode 100644 drivers/video/rockchip-cmd-panel.c

diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index 15000e21..fb7e065d 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -710,6 +710,16 @@ config VIDEO_LCD_HITACHI_TX18D42VM
 	  lcd controller which needs to be initialized over SPI, once that is
 	  done they work like a regular LVDS panel.
 
+config VIDEO_ROCKCHIP_CMD_PANEL
+	bool "Command-sequence RGB panel (Rockchip vendor DT format)"
+	depends on PANEL && DM_GPIO
+	help
+	  Generic driver for RGB panels that need an init sequence sent over
+	  a bit-banged 3-wire (9-bit) SPI link, described entirely in the
+	  device tree using the Rockchip vendor panel properties
+	  (rockchip,cmd-type, spi-*-gpios, panel-init-sequence, delays and
+	  display-timings), so vendor panel nodes can be reused.
+
 config VIDEO_LCD_SONY_L4F00430T01
 	bool "Sony L4F00430T01 480x800 LCD panel support"
 	depends on PANEL
diff --git a/drivers/video/Makefile b/drivers/video/Makefile
index 082b8967..3167c834 100644
--- a/drivers/video/Makefile
+++ b/drivers/video/Makefile
@@ -75,6 +75,7 @@ obj-$(CONFIG_VIDEO_LCD_SHARP_LQ079L1SX01) += sharp-lq079l1sx01.o
 obj-$(CONFIG_VIDEO_LCD_SHARP_LQ101R1SX01) += sharp-lq101r1sx01.o
 obj-$(CONFIG_VIDEO_LCD_SSD2828) += ssd2828.o
 obj-$(CONFIG_VIDEO_LCD_TDO_TL070WSH30) += tdo-tl070wsh30.o
+obj-$(CONFIG_VIDEO_ROCKCHIP_CMD_PANEL) += rockchip-cmd-panel.o
 obj-$(CONFIG_VIDEO_LCD_SONY_L4F00430T01) += sony-l4f00430t01.o
 obj-$(CONFIG_VIDEO_LCD_SAMSUNG_S6E63M0) += samsung-s6e63m0.o
 obj-$(CONFIG_VIDEO_MCDE_SIMPLE) += mcde_simple.o
diff --git a/drivers/video/rockchip-cmd-panel.c b/drivers/video/rockchip-cmd-panel.c
new file mode 100644
index 00000000..c28e0dcb
--- /dev/null
+++ b/drivers/video/rockchip-cmd-panel.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Generic command-sequence panel (Rockchip vendor DT format)
+ *
+ * Panels that are fed pixels over parallel RGB but need an init sequence
+ * sent over a 3-wire (9-bit) SPI link. Everything is described in the
+ * device tree with the panel properties of the Rockchip vendor U-Boot and
+ * kernel trees, so such a panel node can be reused almost verbatim:
+ *
+ *   rockchip,cmd-type = "spi";
+ *   spi-scl-gpios, spi-sdi-gpios, spi-cs-gpios   bit-banged SPI link
+ *   enable-gpios, reset-gpios                    optional
+ *   prepare-delay-ms, reset-delay-ms, init-delay-ms, enable-delay-ms
+ *   panel-init-sequence, panel-exit-sequence     command sequences
+ *   display-timings (with native-mode) or panel-timing
+ *   backlight                                    optional
+ *
+ * A command sequence is a byte array of entries:
+ *   <type> <delay-ms> <payload-length> <payload...>
+ * For SPI, type 0 sends the payload as commands (D/C = 0) and any other
+ * type as parameters (D/C = 1), one 9-bit word per entry, MSB first.
+ */
+
+#include <backlight.h>
+#include <dm.h>
+#include <log.h>
+#include <malloc.h>
+#include <panel.h>
+#include <asm/gpio.h>
+#include <dm/device_compat.h>
+#include <linux/delay.h>
+#include <power/regulator.h>
+
+struct cmd_panel_priv {
+	struct gpio_desc enable_gpio;
+	struct gpio_desc reset_gpio;
+	struct gpio_desc scl_gpio;
+	struct gpio_desc sdi_gpio;
+	struct gpio_desc cs_gpio;
+	struct udevice *backlight;
+	struct udevice *power_supply;
+	const u8 *init_seq;
+	int init_len;
+	const u8 *exit_seq;
+	int exit_len;
+	u32 delay_prepare;
+	u32 delay_reset;
+	u32 delay_init;
+	u32 delay_enable;
+	struct display_timing timing;
+	bool prepared;
+};
+
+/*
+ * Bit-bang one 9-bit word (D/C bit + 8 bits), MSB first, data sampled on the
+ * rising edge. CS is driven to 0 to select the panel, as this binding
+ * describes it as an active-high GPIO.
+ */
+static void cmd_panel_spi_write(struct cmd_panel_priv *priv, bool param,
+				u32 value)
+{
+	int i;
+
+	value = (value & 0xff) | (param ? 0x100 : 0);
+
+	dm_gpio_set_value(&priv->cs_gpio, 0);
+	for (i = 0; i < 9; i++) {
+		dm_gpio_set_value(&priv->sdi_gpio, !!(value & 0x100));
+		dm_gpio_set_value(&priv->scl_gpio, 0);
+		udelay(10);
+		dm_gpio_set_value(&priv->scl_gpio, 1);
+		value <<= 1;
+		udelay(10);
+	}
+	dm_gpio_set_value(&priv->cs_gpio, 1);
+}
+
+static int cmd_panel_send_seq(struct udevice *dev, const u8 *seq, int len)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+
+	while (len >= 3) {
+		u8 type = seq[0], delay = seq[1], plen = seq[2];
+		const u8 *payload = seq + 3;
+		int i;
+
+		if (len < 3 + plen) {
+			dev_err(dev, "truncated command sequence\n");
+			return -EINVAL;
+		}
+
+		/* A two byte payload is sent as one word built from both bytes */
+		if (plen == 2)
+			cmd_panel_spi_write(priv, type, payload[0] << 8 | payload[1]);
+		else
+			for (i = 0; i < plen; i++)
+				cmd_panel_spi_write(priv, type, payload[i]);
+
+		if (delay)
+			mdelay(delay);
+
+		seq += 3 + plen;
+		len -= 3 + plen;
+	}
+
+	return 0;
+}
+
+/* Power up and initialise: enable, prepare delay, reset pulse, init delay, init sequence */
+static int cmd_panel_prepare(struct udevice *dev)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (priv->prepared)
+		return 0;
+
+	if (priv->power_supply) {
+		ret = regulator_set_enable_if_allowed(priv->power_supply, true);
+		if (ret)
+			dev_warn(dev, "failed to enable power supply: %d\n", ret);
+	}
+
+	if (dm_gpio_is_valid(&priv->enable_gpio))
+		dm_gpio_set_value(&priv->enable_gpio, 1);
+	mdelay(priv->delay_prepare);
+
+	if (dm_gpio_is_valid(&priv->reset_gpio)) {
+		dm_gpio_set_value(&priv->reset_gpio, 1);
+		mdelay(priv->delay_reset);
+		dm_gpio_set_value(&priv->reset_gpio, 0);
+	}
+	mdelay(priv->delay_init);
+
+	if (priv->init_seq) {
+		ret = cmd_panel_send_seq(dev, priv->init_seq, priv->init_len);
+		if (ret)
+			return ret;
+	}
+
+	priv->prepared = true;
+
+	return 0;
+}
+
+static int cmd_panel_enable_backlight(struct udevice *dev)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = cmd_panel_prepare(dev);
+	if (ret) {
+		dev_err(dev, "panel init failed: %d\n", ret);
+		return ret;
+	}
+
+	mdelay(priv->delay_enable);
+
+	if (!priv->backlight)
+		return 0;
+
+	return backlight_enable(priv->backlight);
+}
+
+static int cmd_panel_set_backlight(struct udevice *dev, int percent)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+
+	if (!priv->backlight)
+		return -ENOSYS;
+
+	return backlight_set_brightness(priv->backlight, percent);
+}
+
+static int cmd_panel_get_display_timing(struct udevice *dev,
+					struct display_timing *timing)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+
+	*timing = priv->timing;
+
+	return 0;
+}
+
+/* Index of the display-timings child selected by native-mode (default 0) */
+static int cmd_panel_native_mode(struct udevice *dev)
+{
+	ofnode timings = dev_read_subnode(dev, "display-timings");
+	ofnode node, native;
+	u32 phandle;
+	int index = 0;
+
+	if (!ofnode_valid(timings) ||
+	    ofnode_read_u32(timings, "native-mode", &phandle))
+		return 0;
+
+	native = ofnode_get_by_phandle(phandle);
+	ofnode_for_each_subnode(node, timings) {
+		if (ofnode_equal(node, native))
+			return index;
+		index++;
+	}
+
+	return 0;
+}
+
+static int cmd_panel_of_to_plat(struct udevice *dev)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+	const char *cmd_type;
+	int ret;
+
+	cmd_type = dev_read_string(dev, "rockchip,cmd-type");
+	if (!cmd_type || strcmp(cmd_type, "spi")) {
+		dev_err(dev, "only rockchip,cmd-type = \"spi\" is supported\n");
+		return -EINVAL;
+	}
+
+	ret = dev_decode_display_timing(dev, cmd_panel_native_mode(dev),
+					&priv->timing);
+	if (ret)
+		ret = dev_decode_panel_timing(dev, &priv->timing);
+	if (ret) {
+		dev_err(dev, "no display-timings/panel-timing: %d\n", ret);
+		return ret;
+	}
+
+	priv->init_seq = dev_read_prop(dev, "panel-init-sequence",
+				       &priv->init_len);
+	priv->exit_seq = dev_read_prop(dev, "panel-exit-sequence",
+				       &priv->exit_len);
+	priv->delay_prepare = dev_read_u32_default(dev, "prepare-delay-ms", 0);
+	priv->delay_reset = dev_read_u32_default(dev, "reset-delay-ms", 0);
+	priv->delay_init = dev_read_u32_default(dev, "init-delay-ms", 0);
+	priv->delay_enable = dev_read_u32_default(dev, "enable-delay-ms", 0);
+
+	return 0;
+}
+
+static int cmd_panel_probe(struct udevice *dev)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = gpio_request_by_name(dev, "spi-scl-gpios", 0, &priv->scl_gpio,
+				   GPIOD_IS_OUT | GPIOD_IS_OUT_ACTIVE);
+	if (!ret)
+		ret = gpio_request_by_name(dev, "spi-sdi-gpios", 0,
+					   &priv->sdi_gpio, GPIOD_IS_OUT);
+	if (!ret)
+		ret = gpio_request_by_name(dev, "spi-cs-gpios", 0,
+					   &priv->cs_gpio,
+					   GPIOD_IS_OUT | GPIOD_IS_OUT_ACTIVE);
+	if (ret) {
+		dev_err(dev, "missing spi-{scl,sdi,cs}-gpios: %d\n", ret);
+		return ret;
+	}
+
+	ret = gpio_request_by_name(dev, "enable-gpios", 0, &priv->enable_gpio,
+				   GPIOD_IS_OUT);
+	if (ret && ret != -ENOENT)
+		return ret;
+
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset_gpio,
+				   GPIOD_IS_OUT);
+	if (ret && ret != -ENOENT)
+		return ret;
+
+	if (uclass_get_device_by_phandle(UCLASS_PANEL_BACKLIGHT, dev,
+					 "backlight", &priv->backlight))
+		priv->backlight = NULL;
+
+	if (device_get_supply_regulator(dev, "power-supply",
+					&priv->power_supply))
+		priv->power_supply = NULL;
+
+	return 0;
+}
+
+static int cmd_panel_remove(struct udevice *dev)
+{
+	struct cmd_panel_priv *priv = dev_get_priv(dev);
+
+	if (priv->prepared && priv->exit_seq)
+		cmd_panel_send_seq(dev, priv->exit_seq, priv->exit_len);
+
+	return 0;
+}
+
+static const struct panel_ops cmd_panel_ops = {
+	.enable_backlight	= cmd_panel_enable_backlight,
+	.set_backlight		= cmd_panel_set_backlight,
+	.get_display_timing	= cmd_panel_get_display_timing,
+};
+
+static const struct udevice_id cmd_panel_ids[] = {
+	{ .compatible = "rockchip,cmd-panel" },
+	{ }
+};
+
+U_BOOT_DRIVER(rockchip_cmd_panel) = {
+	.name		= "rockchip_cmd_panel",
+	.id		= UCLASS_PANEL,
+	.of_match	= cmd_panel_ids,
+	.ops		= &cmd_panel_ops,
+	.of_to_plat	= cmd_panel_of_to_plat,
+	.probe		= cmd_panel_probe,
+	.remove		= cmd_panel_remove,
+	.priv_auto	= sizeof(struct cmd_panel_priv),
+	.flags		= DM_FLAG_OS_PREPARE,
+};

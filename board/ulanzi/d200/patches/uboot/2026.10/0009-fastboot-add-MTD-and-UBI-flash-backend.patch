From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sun, 18 Oct 2026 16:08:00 -0500
Subject: [PATCH] fastboot: add MTD and UBI flash backend

Add a "FASTBOOT on MTD partitions" flash provider, for boards whose
storage is an MTD device such as a SPI NAND (the existing NAND provider
only handles raw NAND with mtdparts).

Partitions are looked up by name with the MTD API, so they come from
the device tree "partitions" node or mtdparts. Flashing erases the whole
partition, then writes the image page by page, skipping bad blocks and
all-0xff pages, so UBI images can be flashed as they are. Erasing erases
the partition. Sparse images are not supported.

With FASTBOOT_FLASH_MTD_UBI, names that are not MTD partitions are UBI
volumes: "<mtd-partition>:<volume>", or just "<volume>" on the attached
UBI device (FASTBOOT_FLASH_MTD_UBI_PART is attached if none is).
Flashing replaces the volume contents, erasing empties the volume.
Volumes can be created with "oem run:ubi create ...". Flashing or
erasing the MTD partition UBI is attached to detaches UBI first.

getvar partition-size reports the size of the partition or volume.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 drivers/fastboot/Kconfig      |  31 +++-
 drivers/fastboot/Makefile     |   1 +
 drivers/fastboot/fb_command.c |   8 +
 drivers/fastboot/fb_getvar.c  |   3 +
 drivers/fastboot/fb_mtd.c     | 313 ++++++++++++++++++++++++++++++++++
 include/fb_mtd.h              |  38 +++++
 6 files changed, 393 insertions(+), 1 deletion(-)
 create mode 100644 drivers/fastboot/fb_mtd.c
 create mode 100644 include/fb_mtd.h

diff --git a/drivers/fastboot/Kconfig b/drivers/fastboot/Kconfig
index 1887f78b..7ab07b64 100644
--- a/drivers/fastboot/Kconfig
+++ b/drivers/fastboot/Kconfig
@@ -92,7 +92,7 @@ config FASTBOOT_FLASH
 	bool "Enable FASTBOOT FLASH command"
 	default y if ARCH_SUNXI && ( MMC || MTD_RAW_NAND )
 	default y if ARCH_ROCKCHIP && MMC
-	depends on MMC || (MTD_RAW_NAND && CMD_MTDPARTS) || DM_SPI_FLASH || BLK
+	depends on MMC || (MTD_RAW_NAND && CMD_MTDPARTS) || DM_SPI_FLASH || BLK || MTD
 	select IMAGE_SPARSE
 	help
 	  The fastboot protocol includes a "flash" command for writing
@@ -128,8 +128,37 @@ config FASTBOOT_FLASH_BLOCK
 	bool "FASTBOOT on block device"
 	depends on BLK
 
+config FASTBOOT_FLASH_MTD
+	bool "FASTBOOT on MTD partitions"
+	depends on MTD
+	help
+	  Flash and erase MTD partitions by name (for example the partitions
+	  of a SPI NAND described in the device tree). Bad blocks are
+	  skipped and all-0xff pages are not written, so UBI images can be
+	  flashed as they are. Sparse images are not supported.
+
 endchoice
 
+config FASTBOOT_FLASH_MTD_UBI
+	bool "Also flash and erase UBI volumes"
+	depends on FASTBOOT_FLASH_MTD && CMD_UBI
+	help
+	  Names that are not MTD partitions are UBI volumes, given as
+	  "<mtd-partition>:<volume>" or as "<volume>" on the attached UBI
+	  device. Flashing replaces the volume contents (the volume must
+	  exist and be big enough; create it with "oem run:ubi create ..."
+	  if needed), erasing leaves the volume empty. Flashing or erasing
+	  the MTD partition UBI is attached to detaches UBI first.
+
+config FASTBOOT_FLASH_MTD_UBI_PART
+	string "MTD partition to attach UBI to"
+	depends on FASTBOOT_FLASH_MTD_UBI
+	default ""
+	help
+	  MTD partition attached when a plain "<volume>" name is used while
+	  no UBI device is attached. Leave empty to require an attached UBI
+	  device or the "<mtd-partition>:<volume>" form.
+
 config FASTBOOT_FLASH_MMC_DEV
 	int "Define FASTBOOT MMC FLASH default device"
 	depends on FASTBOOT_FLASH_MMC
diff --git a/drivers/fastboot/Makefile b/drivers/fastboot/Makefile
index a341af07..fc102090 100644
--- a/drivers/fastboot/Makefile
+++ b/drivers/fastboot/Makefile
@@ -8,3 +8,4 @@ obj-$(CONFIG_FASTBOOT_FLASH_BLOCK) += fb_block.o
 obj-$(CONFIG_FASTBOOT_FLASH_MMC) += fb_block.o fb_mmc.o
 obj-$(CONFIG_FASTBOOT_FLASH_NAND) += fb_nand.o
 obj-$(CONFIG_FASTBOOT_FLASH_SPI) += fb_spi_flash.o
+obj-$(CONFIG_FASTBOOT_FLASH_MTD) += fb_mtd.o
diff --git a/drivers/fastboot/fb_command.c b/drivers/fastboot/fb_command.c
index 18d86988..b6a346b5 100644
--- a/drivers/fastboot/fb_command.c
+++ b/drivers/fastboot/fb_command.c
@@ -10,6 +10,7 @@
 #include <fastboot-internal.h>
 #include <fb_block.h>
 #include <fb_mmc.h>
+#include <fb_mtd.h>
 #include <fb_nand.h>
 #include <fb_spi_flash.h>
 #include <part.h>
@@ -354,6 +355,10 @@ static void __maybe_unused flash(char *cmd_parameter, char *response)
 	if (IS_ENABLED(CONFIG_FASTBOOT_FLASH_SPI))
 		fastboot_spi_flash_write(cmd_parameter, fastboot_buf_addr,
 					 image_size, response);
+
+	if (IS_ENABLED(CONFIG_FASTBOOT_FLASH_MTD))
+		fastboot_mtd_flash_write(cmd_parameter, fastboot_buf_addr,
+					 image_size, response);
 }
 
 /**
@@ -378,6 +383,9 @@ static void __maybe_unused erase(char *cmd_parameter, char *response)
 
 	if (IS_ENABLED(CONFIG_FASTBOOT_FLASH_SPI))
 		fastboot_spi_flash_erase(cmd_parameter, response);
+
+	if (IS_ENABLED(CONFIG_FASTBOOT_FLASH_MTD))
+		fastboot_mtd_erase(cmd_parameter, response);
 }
 
 /**
diff --git a/drivers/fastboot/fb_getvar.c b/drivers/fastboot/fb_getvar.c
index e8aa0e09..f2f8c896 100644
--- a/drivers/fastboot/fb_getvar.c
+++ b/drivers/fastboot/fb_getvar.c
@@ -8,6 +8,7 @@
 #include <fastboot-internal.h>
 #include <fb_mmc.h>
 #include <fb_block.h>
+#include <fb_mtd.h>
 #include <fb_nand.h>
 #include <fb_spi_flash.h>
 #include <fs.h>
@@ -135,6 +136,8 @@ static int getvar_get_part_info(const char *part_name, char *response,
 						     response);
 		if (r >= 0 && size)
 			*size = disk_part.size * disk_part.blksz;
+	} else if (IS_ENABLED(CONFIG_FASTBOOT_FLASH_MTD)) {
+		r = fastboot_mtd_get_part_info(part_name, size, response);

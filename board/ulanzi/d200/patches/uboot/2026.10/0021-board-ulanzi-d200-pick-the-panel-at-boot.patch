--- a/configs/ulanzi-d200-rk3308_defconfig
+++ b/configs/ulanzi-d200-rk3308_defconfig
@@ -128,4 +128,4 @@ CONFIG_BOOTCOUNT_ENV=y
 CONFIG_BOOTCOUNT_BOOTLIMIT=3
 CONFIG_BOOTCOUNT_ALTBOOTCMD="run d200_altboot"
 CONFIG_ENV_WRITEABLE_LIST=y
-CONFIG_ENV_FLAGS_LIST_STATIC="slot:sw,upgrade_available:dw,bootcount:dw,ota_result:sw"
+CONFIG_ENV_FLAGS_LIST_STATIC="slot:sw,upgrade_available:dw,bootcount:dw,ota_result:sw,panel:sw"

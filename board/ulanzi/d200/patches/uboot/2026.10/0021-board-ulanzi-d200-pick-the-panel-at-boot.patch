index d90febde..551650d2 100644
--- a/board/ulanzi/d200/Makefile
+++ b/board/ulanzi/d200/Makefile
@@ -3,7 +3,13 @@
 ifdef CONFIG_XPL_BUILD
 obj-y	+= spl.o
 else
-obj-y	+= d200.o
+obj-y	+= d200.o panel.o
+
+# The panel overlays, shared with Linux
+obj-y	+= rk3308-ulanzi-d200-panel-h3.dtbo.o

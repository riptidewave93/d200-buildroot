From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Mon, 19 Oct 2026 13:55:36 -0500
Subject: [PATCH] board: ulanzi: d200: check the maskrom keys first thing in
 SPL

The recovery key combination was checked in spl_board_init(), after
driver model, DRAM, the console and the boot device were set up. A
problem in any of those (for example a broken SPL update) made the keys
useless.

Check them in board_early_init_f() instead, the first thing SPL runs.
Only the secure timer is set up first, for the delays, and as there is
no sysreset driver yet the reset goes through the CRU directly.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 board/ulanzi/d200/Makefile           |  2 +-
 board/ulanzi/d200/spl.c              | 29 ++++++++++++++++++++--------
 configs/ulanzi-d200-rk3308_defconfig |  1 -
 3 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/board/ulanzi/d200/Makefile b/board/ulanzi/d200/Makefile
index cc6881ef..d90febde 100644
--- a/board/ulanzi/d200/Makefile
+++ b/board/ulanzi/d200/Makefile
@@ -1,7 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0+
 
 ifdef CONFIG_XPL_BUILD
-obj-$(CONFIG_SPL_BOARD_INIT)	+= spl.o
+obj-y	+= spl.o
 else
 obj-y	+= d200.o
 
diff --git a/board/ulanzi/d200/spl.c b/board/ulanzi/d200/spl.c
index 80464fc9..2aeb82d4 100644
--- a/board/ulanzi/d200/spl.c
+++ b/board/ulanzi/d200/spl.c
@@ -6,28 +6,41 @@
  * SPL enter the BootROM USB download (maskrom) mode instead of loading
  * U-Boot proper, so the board can be recovered over USB even when U-Boot
  * proper is broken.
+ *
+ * The keys are checked first thing in SPL, before driver model, DRAM, the
+ * console and the NAND are set up, so a problem in any of those can't get
+ * in the way.
  */
 
-#include <cpu_func.h>
-#include <spl.h>
-#include <stdio.h>
+#include <init.h>
 #include <asm/io.h>
 #include <asm/arch-rockchip/boot_mode.h>
+#include <asm/arch-rockchip/cru_rk3308.h>
+#include <asm/arch-rockchip/timer.h>
 #include <linux/delay.h>
 #include "keys.h"
 
 #define RECOVERY_ROWS	(D200_KEY_ROW_TOP | D200_KEY_ROW_BOTTOM)
+#define D200_CRU_BASE	0xff500000
+#define GLB_SRST_FST	0xfdb9
 
-void spl_board_init(void)
+int board_early_init_f(void)
 {
+	struct rk3308_cru *cru = (struct rk3308_cru *)D200_CRU_BASE;
+
+	/* the arch timer runs off the secure timer, needed for the delays */
+	rockchip_stimer_init();
+
 	/* require the combination on two samples to ignore glitches */
 	if (!d200_keys_held(D200_KEY_COL_LEFT, RECOVERY_ROWS))
-		return;
+		return 0;
 	mdelay(10);
 	if (!d200_keys_held(D200_KEY_COL_LEFT, RECOVERY_ROWS))
-		return;
+		return 0;
 
-	puts("D200: recovery keys held, entering maskrom (USB download) mode\n");
+	/* no sysreset driver yet: reset through the CRU directly */
 	writel(BOOT_BROM_DOWNLOAD, CONFIG_ROCKCHIP_BOOT_MODE_REG);
-	reset_cpu();
+	writel(GLB_SRST_FST, &cru->glb_srst_fst);
+	for (;;)
+		;
 }
diff --git a/configs/ulanzi-d200-rk3308_defconfig b/configs/ulanzi-d200-rk3308_defconfig
index 1c7c4eef..b6645cfc 100644
--- a/configs/ulanzi-d200-rk3308_defconfig
+++ b/configs/ulanzi-d200-rk3308_defconfig
@@ -122,7 +122,6 @@ CONFIG_FASTBOOT_FLASH_MTD_FIXED_PARTS="idbloader"
 CONFIG_FASTBOOT_OEM_RUN=y
 CONFIG_CONSOLE_RECORD=y
 CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
-CONFIG_SPL_BOARD_INIT=y
 # A/B boot, see board/ulanzi/d200/ulanzi-d200.env
 CONFIG_ENV_SOURCE_FILE="ulanzi-d200"
 CONFIG_BOOTCOUNT_LIMIT=y

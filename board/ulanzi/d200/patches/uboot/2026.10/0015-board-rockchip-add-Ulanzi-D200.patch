diff --git a/arch/arm/dts/rk3308-ulanzi-d200-u-boot.dtsi b/arch/arm/dts/rk3308-ulanzi-d200-u-boot.dtsi
new file mode 100644
index 00000000..3bec9cd0
--- /dev/null
+++ b/arch/arm/dts/rk3308-ulanzi-d200-u-boot.dtsi
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include "rk3308-u-boot.dtsi"
+
+&uart2 {
+	bootph-all;
+	clock-frequency = <24000000>;
+};
+
+&uart2m1_xfer {
+	bootph-all;
+};
+
+/* SPL loads U-Boot proper from SPI NAND */
+&sfc {
+	bootph-pre-ram;
+	bootph-some-ram;
+	/* SFC DMA cannot write to SRAM, where parts of TF-A get loaded */
+	u-boot,spl-sfc-no-dma;
+};
+
+&sfc_clk {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&sfc_cs0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&sfc_bus4 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&{/spi@ff4c0000/flash@0} {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+/* Bind before relocation so the framebuffer gets reserved */
+&vop {
+	bootph-some-ram;
+};
+
+/* The PWM regulator driver needs a start voltage: the vendor boot value */
+&vdd_core {
+	regulator-init-microvolt = <1015000>;
+};

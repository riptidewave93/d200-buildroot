@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ulanzi D200
+ */
+
+#include <dm.h>
+#include <log.h>
+#include <malloc.h>
+#include <mapmem.h>
+#include <splash.h>
+#include <video.h>
+#include <linux/sizes.h>
+
+#if IS_ENABLED(CONFIG_CMD_UBI)
+#include <ubi_uboot.h>
+
+#define D200_SPLASH_UBI_PART	"ubi"
+#define D200_SPLASH_VOLUME	"splash"
+#define D200_SPLASH_MAX_SIZE	SZ_8M
+
+/*
+ * Optional user splash: if the "ubi" partition holds a UBI volume named
+ * "splash" containing a BMP, show it centred on the (landscape) screen
+ * instead of the built-in logo. Anything missing or invalid keeps the
+ * built-in logo.
+ */
+static void d200_show_ubi_splash(struct udevice *dev)
+{
+	struct ubi_volume *vol;
+	size_t size;
+	u8 *buf;
+	int ret;
+
+	if (ubi_part(D200_SPLASH_UBI_PART, NULL))
+		return;
+
+	vol = ubi_find_volume(D200_SPLASH_VOLUME);
+	if (!vol)
+		return;
+
+	size = vol->used_bytes;
+	if (size < 54 || size > D200_SPLASH_MAX_SIZE) {
+		log_warning("splash: volume size %zu not supported\n", size);
+		return;
+	}
+
+	buf = malloc(size);
+	if (!buf)
+		return;
+
+	ret = ubi_volume_read(D200_SPLASH_VOLUME, buf, 0, size);
+	if (ret || buf[0] != 'B' || buf[1] != 'M') {
+		log_warning("splash: volume does not hold a BMP (%d)\n", ret);
+		goto out;
+	}
+
+	video_clear(dev);
+	ret = video_bmp_display(dev, map_to_sysmem(buf), BMP_ALIGN_CENTER,
+				BMP_ALIGN_CENTER, true);
+	if (ret) {
+		log_warning("splash: cannot display BMP (%d), using built-in logo\n",
+			    ret);
+		video_clear(dev);
+		if (IS_ENABLED(CONFIG_VIDEO_LOGO))
+			video_bmp_display(dev,
+					  map_to_sysmem(video_get_u_boot_logo()),
+					  -4, 4, true);
+	}
+	video_sync(dev, true);
+
+out:
+	free(buf);
+}
+#else
+static inline void d200_show_ubi_splash(struct udevice *dev) {}
+#endif
+
+/*
+ * The console is on the UART only, so nothing would probe the display.
+ * Probe it here so the panel comes up and shows the boot logo (built-in,
+ * or the optional splash from UBI).
+ */
+int rk_board_late_init(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	ret = uclass_first_device_err(UCLASS_VIDEO, &dev);
+	if (ret) {
+		log_warning("display: probe failed: %d\n", ret);
+		return 0;
+	}
+
+	d200_show_ubi_splash(dev);
+
+	return 0;
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sun, 18 Oct 2026 18:27:35 -0500
Subject: [PATCH] thermal: rockchip: add RK3308B-S support

The RK3308B-S TSADC has one channel. Its 12-bit code rises linearly
with the temperature (code = 2796 + 2.699 * T), so the conversion
table only needs its end points. Unlike the RK3328-style controllers
it is used without the Q_SEL inversion.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 drivers/thermal/rockchip_thermal.c | 34 ++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/drivers/thermal/rockchip_thermal.c b/drivers/thermal/rockchip_thermal.c
index c49ddf70f..0d7b4c34d 100644
--- a/drivers/thermal/rockchip_thermal.c
+++ b/drivers/thermal/rockchip_thermal.c
@@ -409,6 +409,14 @@ static const struct tsadc_table rk3288_code_table[] = {
 	{0, 125000},
 };
 
+/* The sensor is linear: code = 2796 + 2.699 * T(degC) */
+static const struct tsadc_table rk3308bs_code_table[] = {
+	{0, -40000},
+	{2688, -40000},
+	{3133, 125000},
+	{TSADCV2_DATA_MASK, 125000},
+};
+
 static const struct tsadc_table rk3328_code_table[] = {
 	{0, -40000},
 	{296, -40000},
@@ -1189,6 +1197,28 @@ static const struct rockchip_tsadc_chip rk3288_tsadc_data = {
 	},
 };
 
+static const struct rockchip_tsadc_chip rk3308bs_tsadc_data = {
+	/* cpu */
+	.chn_offset = 0,
+	.chn_num = 1, /* one channel for tsadc */
+	.grf_required = false,
+	.tshut_mode = TSHUT_MODE_CRU, /* default TSHUT via CRU */
+	.tshut_temp = 95000,
+	.initialize = rk_tsadcv2_initialize,
+	.irq_ack = rk_tsadcv3_irq_ack,
+	.control = rk_tsadcv2_control,
+	.get_temp = rk_tsadcv2_get_temp,
+	.set_alarm_temp = rk_tsadcv2_alarm_temp,
+	.set_tshut_temp = rk_tsadcv2_tshut_temp,
+	.set_tshut_mode = rk_tsadcv2_tshut_mode,
+	.table = {
+		.id = rk3308bs_code_table,
+		.length = ARRAY_SIZE(rk3308bs_code_table),
+		.data_mask = TSADCV2_DATA_MASK,
+		.mode = ADC_INCREMENT,
+	},
+};
+
 static const struct rockchip_tsadc_chip rk3328_tsadc_data = {
 	/* cpu */
 	.chn_offset = 0,
@@ -1367,6 +1397,10 @@ static const struct of_device_id of_rockchip_thermal_match[] = {
 		.compatible = "rockchip,rk3288-tsadc",
 		.data = (void *)&rk3288_tsadc_data,
 	},
+	{
+		.compatible = "rockchip,rk3308bs-tsadc",
+		.data = (void *)&rk3308bs_tsadc_data,
+	},
 	{
 		.compatible = "rockchip,rk3328-tsadc",
 		.data = (void *)&rk3328_tsadc_data,

diff --git a/drivers/gpu/drm/panel/panel-rockchip-cmd.c b/drivers/gpu/drm/panel/panel-rockchip-cmd.c
new file mode 100644
index 000000000..1384b8467
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-rockchip-cmd.c
@@ -0,0 +1,398 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Command sequence panels in the Rockchip vendor device tree format
+ *
+ * Parallel RGB panels whose controller is set up with a sequence of commands
+ * sent over a 3-wire SPI link with 9-bit words, bit-banged on GPIOs. The
+ * timings, power up delays and command sequences all come from the device
+ * tree.
+ *
+ * A command sequence is a byte array of entries:
+ *   <type> <delay-ms> <payload-length> <payload...>
+ * Type 0 sends the payload as commands (D/C = 0), any other type as
+ * parameters (D/C = 1), one 9-bit word per payload byte. A two byte payload
+ * is a single word whose low byte is the second byte.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/media-bus-format.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/display_timing.h>
+#include <video/of_display_timing.h>
+#include <video/of_videomode.h>
+#include <video/videomode.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+/* Half period of the bit-banged SPI clock */
+#define CMD_PANEL_SPI_DELAY_US	10
+
+struct cmd_panel_seq {
+	const u8 *data;
+	int len;
+};
+
+struct cmd_panel {
+	struct drm_panel panel;
+	struct device *dev;
+
+	struct regulator *supply;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *scl_gpio;
+	struct gpio_desc *sdi_gpio;
+	struct gpio_desc *cs_gpio;
+
+	struct cmd_panel_seq init_seq;
+	struct cmd_panel_seq exit_seq;
+
+	u32 delay_prepare;
+	u32 delay_reset;
+	u32 delay_init;
+	u32 delay_enable;
+	u32 delay_disable;
+	u32 delay_unprepare;
+
+	struct drm_display_mode mode;
+	u32 bus_flags;
+	u32 bus_format;
+	u32 bpc;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct cmd_panel *to_cmd_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct cmd_panel, panel);
+}
+
+/*
+ * Send one 9-bit word, D/C bit first, then the 8 data bits MSB first. Data
+ * is sampled on the rising clock edge. The chip select GPIO is driven to 0
+ * to select the panel.
+ */
+static void cmd_panel_spi_write(struct cmd_panel *ctx, bool param, u8 value)
+{
+	u16 word = value | (param ? 0x100 : 0);
+	int i;
+
+	gpiod_set_value_cansleep(ctx->cs_gpio, 0);
+
+	for (i = 0; i < 9; i++) {
+		gpiod_set_value_cansleep(ctx->sdi_gpio, !!(word & 0x100));
+		gpiod_set_value_cansleep(ctx->scl_gpio, 0);
+		udelay(CMD_PANEL_SPI_DELAY_US);
+		gpiod_set_value_cansleep(ctx->scl_gpio, 1);
+		udelay(CMD_PANEL_SPI_DELAY_US);
+		word <<= 1;
+	}
+
+	gpiod_set_value_cansleep(ctx->cs_gpio, 1);
+}
+
+static void cmd_panel_send_seq(struct cmd_panel *ctx,
+			       const struct cmd_panel_seq *seq)
+{
+	const u8 *p = seq->data;
+	int len = seq->len;
+
+	/* The sequences have been validated at probe time */
+	while (len >= 3) {
+		u8 type = p[0], delay = p[1], plen = p[2];
+		const u8 *payload = p + 3;
+		int i;
+
+		if (plen == 2)
+			cmd_panel_spi_write(ctx, type, payload[1]);
+		else
+			for (i = 0; i < plen; i++)
+				cmd_panel_spi_write(ctx, type, payload[i]);
+
+		if (delay)
+			msleep(delay);
+
+		p += 3 + plen;
+		len -= 3 + plen;
+	}
+}
+
+static int cmd_panel_prepare(struct drm_panel *panel)
+{
+	struct cmd_panel *ctx = to_cmd_panel(panel);
+	int ret;
+
+	ret = regulator_enable(ctx->supply);
+	if (ret) {
+		dev_err(ctx->dev, "failed to enable power supply: %d\n", ret);
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	msleep(ctx->delay_prepare);
+
+	if (ctx->reset_gpio) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		msleep(ctx->delay_reset);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	}
+
+	msleep(ctx->delay_init);
+
+	cmd_panel_send_seq(ctx, &ctx->init_seq);
+
+	return 0;
+}
+
+static int cmd_panel_enable(struct drm_panel *panel)
+{
+	struct cmd_panel *ctx = to_cmd_panel(panel);
+
+	msleep(ctx->delay_enable);
+
+	return 0;
+}
+
+static int cmd_panel_disable(struct drm_panel *panel)
+{
+	struct cmd_panel *ctx = to_cmd_panel(panel);
+
+	msleep(ctx->delay_disable);
+
+	return 0;
+}
+
+static int cmd_panel_unprepare(struct drm_panel *panel)
+{
+	struct cmd_panel *ctx = to_cmd_panel(panel);
+
+	cmd_panel_send_seq(ctx, &ctx->exit_seq);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	regulator_disable(ctx->supply);
+
+	msleep(ctx->delay_unprepare);
+
+	return 0;
+}
+
+static int cmd_panel_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct cmd_panel *ctx = to_cmd_panel(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &ctx->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	connector->display_info.bpc = ctx->bpc;
+	connector->display_info.bus_flags = ctx->bus_flags;
+	drm_display_info_set_bus_formats(&connector->display_info,
+					 &ctx->bus_format, 1);
+
+	/*
+	 * TODO: Remove once all drm drivers call
+	 * drm_connector_set_orientation_from_panel()
+	 */
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+
+	return 1;
+}
+
+static enum drm_panel_orientation cmd_panel_get_orientation(struct drm_panel *panel)
+{
+	return to_cmd_panel(panel)->orientation;
+}
+
+static const struct drm_panel_funcs cmd_panel_funcs = {
+	.prepare = cmd_panel_prepare,
+	.enable = cmd_panel_enable,
+	.disable = cmd_panel_disable,
+	.unprepare = cmd_panel_unprepare,
+	.get_modes = cmd_panel_get_modes,
+	.get_orientation = cmd_panel_get_orientation,
+};
+
+static int cmd_panel_parse_seq(struct cmd_panel *ctx, const char *name,
+			       struct cmd_panel_seq *seq)
+{
+	const u8 *p;
+	int len;
+
+	p = of_get_property(ctx->dev->of_node, name, &len);
+	if (!p)
+		return 0;
+
+	seq->data = p;
+	seq->len = len;
+
+	while (len > 0) {
+		if (len < 3 || len < 3 + p[2])
+			return dev_err_probe(ctx->dev, -EINVAL,
+					     "truncated %s\n", name);
+		len -= 3 + p[2];
+		p += 3 + p[2];
+	}
+
+	return 0;
+}
+
+static int cmd_panel_parse_timing(struct cmd_panel *ctx)
+{
+	struct device_node *np = ctx->dev->of_node;
+	struct display_timing dt;
+	struct videomode vm;
+	u32 width_mm, height_mm;
+	int ret;
+
+	ret = of_get_videomode(np, &vm, OF_USE_NATIVE_MODE);
+	if (ret) {
+		ret = of_get_display_timing(np, "panel-timing", &dt);
+		if (ret)
+			return dev_err_probe(ctx->dev, ret,
+					     "no display-timings or panel-timing\n");
+		videomode_from_timing(&dt, &vm);
+	}
+
+	drm_display_mode_from_videomode(&vm, &ctx->mode);
+	drm_bus_flags_from_videomode(&vm, &ctx->bus_flags);
+
+	if (!of_property_read_u32(np, "width-mm", &width_mm))
+		ctx->mode.width_mm = width_mm;
+	if (!of_property_read_u32(np, "height-mm", &height_mm))
+		ctx->mode.height_mm = height_mm;
+
+	return 0;
+}
+
+static int cmd_panel_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct cmd_panel *ctx;
+	const char *cmd_type;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct cmd_panel, panel,
+				   &cmd_panel_funcs, DRM_MODE_CONNECTOR_DPI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dev = dev;
+
+	if (of_property_read_string(np, "rockchip,cmd-type", &cmd_type) ||
+	    strcmp(cmd_type, "spi"))
+		return dev_err_probe(dev, -EINVAL,
+				     "only rockchip,cmd-type = \"spi\" is supported\n");
+
+	ret = cmd_panel_parse_timing(ctx);
+	if (ret)
+		return ret;
+
+	ret = cmd_panel_parse_seq(ctx, "panel-init-sequence", &ctx->init_seq);
+	if (ret)
+		return ret;
+
+	ret = cmd_panel_parse_seq(ctx, "panel-exit-sequence", &ctx->exit_seq);
+	if (ret)
+		return ret;
+
+	of_property_read_u32(np, "prepare-delay-ms", &ctx->delay_prepare);
+	of_property_read_u32(np, "reset-delay-ms", &ctx->delay_reset);
+	of_property_read_u32(np, "init-delay-ms", &ctx->delay_init);
+	of_property_read_u32(np, "enable-delay-ms", &ctx->delay_enable);
+	of_property_read_u32(np, "disable-delay-ms", &ctx->delay_disable);
+	of_property_read_u32(np, "unprepare-delay-ms", &ctx->delay_unprepare);
+
+	ctx->bus_format = MEDIA_BUS_FMT_RGB888_1X24;
+	of_property_read_u32(np, "bus-format", &ctx->bus_format);
+	ctx->bpc = 8;
+	of_property_read_u32(np, "bpc", &ctx->bpc);
+
+	ret = of_drm_get_panel_orientation(np, &ctx->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get orientation\n");
+
+	ctx->supply = devm_regulator_get(dev, "power");
+	if (IS_ERR(ctx->supply))
+		return dev_err_probe(dev, PTR_ERR(ctx->supply),
+				     "failed to get power supply\n");
+
+	ctx->enable_gpio = devm_gpiod_get_optional(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "failed to get enable GPIO\n");
+
+	ctx->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	ctx->scl_gpio = devm_gpiod_get(dev, "spi-scl", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->scl_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->scl_gpio),
+				     "failed to get SPI clock GPIO\n");
+
+	ctx->sdi_gpio = devm_gpiod_get(dev, "spi-sdi", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->sdi_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->sdi_gpio),
+				     "failed to get SPI data GPIO\n");
+
+	ctx->cs_gpio = devm_gpiod_get(dev, "spi-cs", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->cs_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->cs_gpio),
+				     "failed to get SPI chip select GPIO\n");
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+
+	platform_set_drvdata(pdev, ctx);
+	drm_panel_add(&ctx->panel);
+
+	return 0;
+}
+
+static void cmd_panel_remove(struct platform_device *pdev)
+{
+	struct cmd_panel *ctx = platform_get_drvdata(pdev);
+
+	drm_panel_remove(&ctx->panel);
+	drm_panel_disable(&ctx->panel);
+	drm_panel_unprepare(&ctx->panel);
+}
+
+static const struct of_device_id cmd_panel_of_match[] = {
+	{ .compatible = "rockchip,cmd-panel" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cmd_panel_of_match);
+
+static struct platform_driver cmd_panel_driver = {
+	.driver = {
+		.name = "panel-rockchip-cmd",
+		.of_match_table = cmd_panel_of_match,
+	},
+	.probe = cmd_panel_probe,
+	.remove = cmd_panel_remove,
+};
+module_platform_driver(cmd_panel_driver);
+
+MODULE_AUTHOR("Chris Blake <chrisrblake93@gmail.com>");
+MODULE_DESCRIPTION("Rockchip command sequence panel driver");
+MODULE_LICENSE("GPL");

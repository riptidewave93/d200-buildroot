 DRM DRIVER FOR SAMSUNG DB7430 PANELS
 M:	Linus Walleij <linusw@kernel.org>
 S:	Maintained
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 3eac4d0f8..6247ff40c 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -812,6 +812,18 @@ config DRM_PANEL_RENESAS_R69328
 	  This panel controller can be found in LG Optimus 4X P895 smartphone
 	  in combination with LCD panel.
 
+config DRM_PANEL_ROCKCHIP_CMD
+	tristate "Rockchip command sequence panel"
+	depends on OF && GPIOLIB
+	depends on BACKLIGHT_CLASS_DEVICE
+	select VIDEOMODE_HELPERS
+	help
+	  Say Y here if you want to enable support for parallel RGB panels
+	  described with the Rockchip vendor "rockchip,cmd-panel" device
+	  tree binding: the panel controller is set up with command
+	  sequences sent over a bit-banged 3-wire SPI link, and the timings
+	  and power up delays come from the device tree.
+
 config DRM_PANEL_RONBO_RB070D30
 	tristate "Ronbo Electronics RB070D30 panel"
 	depends on OF

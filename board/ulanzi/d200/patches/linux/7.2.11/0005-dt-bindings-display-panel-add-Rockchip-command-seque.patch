From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Sun, 18 Oct 2026 17:50:27 -0500
Subject: [PATCH] dt-bindings: display: panel: add Rockchip command sequence
 panel

Describe the "rockchip,cmd-panel" binding used by the Rockchip vendor
trees for parallel RGB panels whose controller is set up with command
sequences over a bit-banged 3-wire SPI link. The panel timings, power up
delays and command sequences all come from the device tree.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 .../display/panel/rockchip,cmd-panel.yaml     | 165 ++++++++++++++++++
 1 file changed, 165 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/rockchip,cmd-panel.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/rockchip,cmd-panel.yaml b/Documentation/devicetree/bindings/display/panel/rockchip,cmd-panel.yaml
new file mode 100644
index 000000000..59451eb39
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/rockchip,cmd-panel.yaml
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/rockchip,cmd-panel.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip command sequence panel
+
+maintainers:
+  - Chris Blake <chrisrblake93@gmail.com>
+
+description: |
+  A parallel RGB panel whose controller is set up with command sequences
+  sent over a 3-wire SPI link with 9-bit words, bit-banged on GPIOs. The
+  timings, the power up delays and the command sequences are all described
+  in the device tree, in the format of the Rockchip vendor trees.
+
+  A command sequence is a byte array of entries:
+    <type> <delay-ms> <payload-length> <payload...>
+  Type 0 sends the payload as commands (D/C = 0), any other type as
+  parameters (D/C = 1), one 9-bit word per payload byte. A two byte payload
+  is a single word whose low byte is the second byte. After an entry, the
+  driver waits for delay-ms milliseconds.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: rockchip,cmd-panel
+
+  rockchip,cmd-type:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: How the command sequences are sent.
+    const: spi
+
+  spi-scl-gpios:
+    maxItems: 1
+    description: SPI clock. Data is sampled on its rising edge.
+
+  spi-sdi-gpios:
+    maxItems: 1
+    description: SPI data, sent MSB first.
+
+  spi-cs-gpios:
+    maxItems: 1
+    description: SPI chip select, driven to 0 (logical) to select the panel.
+
+  enable-gpios: true
+  reset-gpios: true
+  power-supply: true
+  backlight: true
+  rotation: true
+  port: true
+  panel-timing: true
+  width-mm: true
+  height-mm: true
+
+  display-timings:
+    $ref: display-timings.yaml#
+
+  panel-init-sequence:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    description: Commands sent when the panel is powered up.
+
+  panel-exit-sequence:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    description: Commands sent before the panel is powered down.
+
+  prepare-delay-ms:
+    description: Delay after powering the panel up, before the reset pulse.
+
+  reset-delay-ms:
+    description: Length of the reset pulse.
+
+  init-delay-ms:
+    description: Delay after the reset pulse, before the init sequence.
+
+  enable-delay-ms:
+    description: Delay before the backlight is turned on.
+
+  disable-delay-ms:
+    description: Delay after the backlight is turned off.
+
+  unprepare-delay-ms:
+    description: Delay after powering the panel down.
+
+  bus-format:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Media bus format of the pixel data (MEDIA_BUS_FMT_*). Defaults to
+      MEDIA_BUS_FMT_RGB888_1X24.
+
+  bpc:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Bits per color component. Defaults to 8.
+
+required:
+  - compatible
+  - rockchip,cmd-type
+  - spi-scl-gpios
+  - spi-sdi-gpios
+  - spi-cs-gpios
+  - port
+
+oneOf:
+  - required:
+      - display-timings
+  - required:
+      - panel-timing
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    panel {
+        compatible = "rockchip,cmd-panel";
+        rockchip,cmd-type = "spi";
+        spi-scl-gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
+        spi-sdi-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
+        spi-cs-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
+        enable-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
+        reset-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
+        prepare-delay-ms = <20>;
+        reset-delay-ms = <200>;
+        init-delay-ms = <210>;
+        enable-delay-ms = <200>;
+        backlight = <&backlight>;
+        rotation = <90>;
+        panel-init-sequence = [
+            00 00 01 11 01 c8 01 00
+            00 00 01 29 01 64 01 00
+        ];
+        panel-exit-sequence = [
+            00 0a 01 28 00 78 01 10
+        ];
+
+        display-timings {
+            native-mode = <&timing0>;
+
+            timing0: timing0 {
+                clock-frequency = <42000000>;
+                hactive = <720>;
+                vactive = <1280>;
+                hfront-porch = <60>;
+                hback-porch = <60>;
+                hsync-len = <10>;
+                vfront-porch = <60>;
+                vback-porch = <10>;
+                vsync-len = <5>;
+                hsync-active = <0>;
+                vsync-active = <0>;
+                de-active = <1>;
+                pixelclk-active = <1>;
+            };
+        };
+
+        port {
+            endpoint {
+                remote-endpoint = <&vop_out_panel>;
+            };
+        };
+    };

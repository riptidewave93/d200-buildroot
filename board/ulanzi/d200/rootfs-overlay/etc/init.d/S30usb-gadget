#!/bin/sh
#
# USB gadget on the USB-C port: one composite device with the functions in
# /etc/default/usb-gadget, plus USB Ethernet: the deck's addresses, DHCP for
# the PC and IPv6 router advertisements.
#
# Settings in /data/usb-gadget.conf (KEY=value lines, written by deckd):
#   drive=0       no USB drive (msc); anything else, or no file, keeps it
#   net4=<IPv4>   use the /30 holding this address (deck first, PC second)
#                 instead of the one derived from the serial
# "apply" makes the running gadget match them.
#

USB_FUNCTIONS="hid raw ncm msc"
[ -r /etc/default/usb-gadget ] && . /etc/default/usb-gadget

G=/sys/kernel/config/usb_gadget/d200
UDHCPD_CONF=/tmp/udhcpd-usb.conf
UDHCPD_PID=/var/run/udhcpd-usb.pid
RADVD_CONF=/tmp/radvd-usb.conf
RADVD_PID=/var/run/radvd-usb.pid
USB_DRIVE=/tmp/usb-drive.img
SHARE=/usr/share/d200
SETTINGS=/data/usb-gadget.conf

# CPU serial, passed on by U-Boot
serial() {
	s=$(tr -d '\0' < /proc/device-tree/serial-number 2>/dev/null)
	echo "${s:-0000000000000000}"
}

# stable, locally administered MAC address from the serial; $1 = first byte
mac() {
	serial | md5sum | sed "s/^\(..\)\(..\)\(..\)\(..\)\(..\).*/$1:\1:\2:\3:\4:\5/"
}

setting() {
	sed -n "s/^$1=//p" $SETTINGS 2>/dev/null | tail -n 1
}

drive_wanted() {
	[ "$(setting drive)" != 0 ]
}

add_function() {
	case "$1" in
	hid)
		f=functions/hid.usb0
		mkdir $f
		# deckd owns the HID report descriptor
		if ! /usr/bin/deckd hid-descriptor > /tmp/hid-report-desc ||
		   [ ! -s /tmp/hid-report-desc ]; then
			echo "usb-gadget: no HID report descriptor, skipping hid" >&2
			rmdir $f
			return
		fi
		echo 0 > $f/subclass		# report IDs: no boot protocol
		echo 0 > $f/protocol
		echo 9 > $f/report_length	# longest report incl. its ID
		cat /tmp/hid-report-desc > $f/report_desc
		rm -f /tmp/hid-report-desc
		# LED reports over the control endpoint: the USB controller has one
		# RX FIFO for all OUT endpoints, so one nobody reads stalls them all
		echo 1 > $f/no_out_endpoint
		;;
	raw)
		# config channel for the website (WebHID) and the PC app
		f=functions/hid.usb1
		mkdir $f
		if ! /usr/bin/deckd raw-descriptor > /tmp/raw-report-desc ||
		   [ ! -s /tmp/raw-report-desc ]; then
			echo "usb-gadget: no raw HID report descriptor, skipping raw" >&2
			rmdir $f
			return
		fi
		echo 0 > $f/subclass
		echo 0 > $f/protocol
		echo 64 > $f/report_length	# input reports
		cat /tmp/raw-report-desc > $f/report_desc
		rm -f /tmp/raw-report-desc
		echo 1 > $f/no_out_endpoint	# output reports by SET_REPORT, as for hid
		;;
	ncm)
		f=functions/ncm.usb0
		mkdir $f
		mac 06 > $f/host_addr
		mac 02 > $f/dev_addr
		# Windows loads its NCM driver for this compatible ID
		echo WINNCM > $f/os_desc/interface.ncm/compatible_id
		;;
	msc)
		f=functions/mass_storage.usb0
		mkdir $f
		echo 1 > $f/lun.0/removable
		echo 1 > $f/lun.0/ro
		# vendor (8 chars), product (16), revision (4)
		echo "Ulanzi  D200 Deck       0100" > $f/lun.0/inquiry_string
		make_drive
		echo $USB_DRIVE > $f/lun.0/file
		;;
	*)
		echo "usb-gadget: unknown function $1" >&2
		return
		;;
	esac
	ln -s $f configs/c.1/
}

# The USB Ethernet addresses, from deckd usb-net: derived from the CPU serial
# (198.18.0.0/15 and an IPv6 ULA), or net4= in the settings. Without it, the
# fallback below. Sets DEV_IP4 PEER_IP4 DEV_IP6 NET6.
addresses() {
	DEV_IP4=172.31.254.1
	PEER_IP4=172.31.254.2
	DEV_IP6=
	NET6=
	out=$(/usr/bin/deckd usb-net) || return 0
	while IFS== read -r k v; do
		case "$k" in
		DEV_IP4) DEV_IP4=$v ;;
		PEER_IP4) PEER_IP4=$v ;;
		DEV_IP6) DEV_IP6=$v ;;
		NET6) NET6=$v ;;
		esac
	done <<-EOF
		$out
	EOF
}

stop_pid() {
	[ -f "$1" ] || return 0
	p=$(cat "$1")
	kill "$p" 2>/dev/null
	for i in 1 2 3 4 5; do
		kill -0 "$p" 2>/dev/null || break
		sleep 1
	done
	rm -f "$1"
}

# DHCP: the PC gets PEER_IP4 on interface $1
start_udhcpd() {
	cat > $UDHCPD_CONF <<-EOF
		interface $1
		start $PEER_IP4
		end $PEER_IP4
		max_leases 1
		lease_file /tmp/udhcpd-usb.leases
		option subnet 255.255.255.252
		option lease 86400
	EOF
	rm -f /tmp/udhcpd-usb.leases
	touch /tmp/udhcpd-usb.leases
	# in the foreground under start-stop-daemon, for its PID: BusyBox has no
	# pidfile support
	start-stop-daemon -S -q -b -m -p $UDHCPD_PID -x /usr/sbin/udhcpd -- -f -S $UDHCPD_CONF
}

# The drive: a RAM copy of the image, its README filled in with the name and
# addresses, rewritten in place (offset and size from the build)
make_drive() {
	cp $SHARE/usb-drive.img $USB_DRIVE
	read off size < $SHARE/usb-drive-readme.at || return 0
	sed -e "s|@NAME@|$(hostname).local|g" -e "s|@IPV4@|$DEV_IP4|g" \
		-e "s|@PEER4@|$PEER_IP4|g" -e "s|@IPV6@|${DEV_IP6:-none}|g" \
		$SHARE/usb-drive-readme.md > /tmp/readme
	if [ "$(wc -c < /tmp/readme)" -le "$size" ]; then
		{ cat /tmp/readme; tr '\0' ' ' < /dev/zero; } | head -c "$size" |
			dd of=$USB_DRIVE bs=1 seek="$off" conv=notrunc 2>/dev/null
	fi
	rm -f /tmp/readme
}

start_network() {
	ifname=$(cat $G/functions/ncm.usb0/ifname)
	ip addr add $DEV_IP4/30 brd + dev "$ifname"
	[ -n "$DEV_IP6" ] && ip -6 addr add $DEV_IP6/64 dev "$ifname"
	ip link set "$ifname" up
	start_udhcpd "$ifname"

	[ -n "$NET6" ] || return
	# the PC takes an address from the prefix but no route through the deck
	cat > $RADVD_CONF <<-EOF
		interface $ifname {
			AdvSendAdvert on;
			IgnoreIfMissing on;
			MaxRtrAdvInterval 60;
			AdvDefaultLifetime 0;
			prefix $NET6 {
				AdvOnLink on;
				AdvAutonomous on;
			};
		};
	EOF
	radvd -C $RADVD_CONF -p $RADVD_PID
}

start() {
	printf "Starting USB gadget: "
	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
	[ -d $G ] && { echo "already set up"; return 0; }

	mkdir $G && cd $G || { echo "FAIL"; return 1; }
	echo 0x1d6b > idVendor		# Linux Foundation
	echo 0x0104 > idProduct		# Multifunction Composite Gadget
	echo 0x0102 > bcdDevice		# USB descriptor layout version
	echo 0x0200 > bcdUSB
	# composite device with interface association descriptors
	echo 0xef > bDeviceClass
	echo 0x02 > bDeviceSubClass
	echo 0x01 > bDeviceProtocol
	mkdir strings/0x409
	echo Ulanzi > strings/0x409/manufacturer
	echo D200 > strings/0x409/product
	serial > strings/0x409/serialnumber

	mkdir configs/c.1 configs/c.1/strings/0x409
	echo D200 > configs/c.1/strings/0x409/configuration
	echo 500 > configs/c.1/MaxPower
	echo 0xa0 > configs/c.1/bmAttributes	# bus powered, remote wakeup
	# Microsoft OS descriptors, for the WINNCM compatible ID
	echo 1 > os_desc/use
	echo 0xcd > os_desc/b_vendor_code
	echo MSFT100 > os_desc/qw_sign
	ln -s configs/c.1 os_desc/

	addresses
	# the mDNS name, d200-<serial>.local
	[ -r /proc/device-tree/serial-number ] && hostname "d200-$(serial | tr A-F a-f)"
	for f in $USB_FUNCTIONS; do
		[ "$f" = msc ] && ! drive_wanted && continue
		add_function "$f"
	done

	ls /sys/class/udc | head -n 1 > UDC || { echo "FAIL"; return 1; }
	[ -d functions/ncm.usb0 ] && start_network
	echo "OK"
}

# A change re-binds the gadget: the PC sees the D200 unplugged and plugged back
# in (and asks for a new address), and /dev/hidg* are recreated.
apply() {
	[ -d $G ] || { start; return; }
	cd $G || return 1
	drive=0
	case " $USB_FUNCTIONS " in *" msc "*)
		have=0; [ -e configs/c.1/mass_storage.usb0 ] && have=1
		want=0; drive_wanted && want=1
		[ $have = $want ] || drive=1
	esac
	net=0
	addresses
	if [ -d functions/ncm.usb0 ]; then
		ifname=$(cat functions/ncm.usb0/ifname)
		cur=$(ip -4 addr show dev "$ifname" | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p')
		[ "$cur" = "$DEV_IP4" ] || net=1
	fi
	[ $drive = 0 ] && [ $net = 0 ] && return 0

	echo "" > UDC || return 1
	ret=0
	if [ $drive = 1 ]; then
		if [ $want = 1 ]; then
			add_function msc
		else
			rm configs/c.1/mass_storage.usb0 && rmdir functions/mass_storage.usb0
		fi || ret=1
	fi
	if [ $net = 1 ]; then
		stop_pid $UDHCPD_PID
		ip -4 addr flush dev "$ifname"
		ip addr add $DEV_IP4/30 brd + dev "$ifname" || ret=1
		start_udhcpd "$ifname" || ret=1
		[ -e configs/c.1/mass_storage.usb0 ] && make_drive
	fi
	ls /sys/class/udc | head -n 1 > UDC || return 1
	return $ret
}

stop() {
	printf "Stopping USB gadget: "
	stop_pid $UDHCPD_PID
	stop_pid $RADVD_PID
	[ -d $G ] || { echo "OK"; return 0; }
	cd $G || return 1
	echo "" > UDC 2>/dev/null
	rm -f os_desc/c.1 configs/c.1/*.*
	for f in functions/*; do
		rmdir "$f"
	done
	rmdir configs/c.1/strings/0x409 configs/c.1 strings/0x409
	cd / && rmdir $G
	echo "OK"
}

case "$1" in
	start|stop|apply)
		"$1";;
	restart|reload)
		stop
		start;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|apply}"
		exit 1
esac

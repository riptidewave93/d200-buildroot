/* 0x00200000: start of RAM after BL31 */
/dts-v1/;

/ {
	description = "Ulanzi D200 Linux";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux kernel";
			data = /incbin/("Image.gz");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "gzip";
			load = <0x00200000>;
			entry = <0x00200000>;
			hash {
				algo = "sha256";
			};
		};

		fdt {
			description = "Ulanzi D200 device tree";
			data = /incbin/("rk3308-ulanzi-d200.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			hash {
				algo = "sha256";
			};
		};

		fdt-panel-h3 {
			description = "Ulanzi D200 h3 panel overlay";
			data = /incbin/("rk3308-ulanzi-d200-panel-h3.dtbo");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			hash {
				algo = "sha256";
			};
		};
	};

	/* One per panel, named as U-Boot's d200_panel */
	configurations {
		default = "h1";

		h1 {
			description = "Ulanzi D200, h1 panel";
			kernel = "kernel";
			fdt = "fdt";
		};

		h3 {
			description = "Ulanzi D200, h3 panel";
			kernel = "kernel";
			fdt = "fdt", "fdt-panel-h3";
		};
	};
};
